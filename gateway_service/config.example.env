# PARTSINTEL Gateway Configuration Template
# Copy this file to .env and configure your credentials.
# NEVER commit .env or secrets to git.

# --- Selected Provider Option 1: Groq Cloud (Recommended - Free Tier, Sub-second Latency) ---
TEAM_PROVIDER_URL=https://api.groq.com/openai/v1/chat/completions
TEAM_PROVIDER_KEY=your_groq_api_key_here
TEAM_MODEL=llama-3.3-70b-versatile

# --- Selected Provider Option 2: Google AI Studio (Free Tier) ---
# TEAM_PROVIDER_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# TEAM_PROVIDER_KEY=your_google_ai_studio_api_key_here
# TEAM_MODEL=gemini-1.5-flash

# --- Selected Provider Option 3: OpenRouter (Free Tier / Prepaid) ---
# TEAM_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
# TEAM_PROVIDER_KEY=your_openrouter_api_key_here
# TEAM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Gateway Ingress Authentication ---
# Generate a secure 32+ character alphanumeric token for portal authentication
# Must match regex [A-Za-z0-9._~+/-]{1,512}
TEAM_GATEWAY_TOKEN=PARTSINTEL_SECRET_TOKEN_GENERATE_RANDOM_STRING_HERE

# --- Local Binding ---
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

